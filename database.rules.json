{
  "rules": {
    // ------------------------------------------------------------------
    // SSmart POS security rules — Google device-binding edition.
    //
    // Deploy: Firebase Console → Realtime Database → Rules → paste → Publish.
    // Or: firebase deploy --only database  (with firebase.json pointing here)
    //
    // Layout:
    //   sales/, products/, customers/, customer_khata/, ...   MASTER (root)
    //       business data. The desktop POS master device syncs here
    //       UNAUTHENTICATED (see src/syncEngine.ts — it never signs in), and
    //       the mobile admin app reads/writes the same root paths. These must
    //       stay public read/write or master sync breaks. Isolation for sold
    //       copies is provided by the tenants/ subtree below, NOT by locking
    //       the root.
    //   tenants/<tenantId>/...   per-Google-account shop data (each Gmail =
    //       its own isolated database for sold copies).
    //   tenantOwners/<tenant>    uid that owns a tenant path.
    //   tenant_map/<fingerprint> device → tenant routing (desktop + mobile
    //       reseller flow).
    //   licenses/<fingerprint>   legacy per-device license record (reseller
    //       flow + the owner's self-provisioned master record).
    //   bindings/<keyId>         device binding for a product key (server lock).
    //   config/...               public config (trial days etc.).
    // ------------------------------------------------------------------

    // ---- Master (root) business data — SERVER-SIDE PROTECTED ----
    // ---- Every sync device (desktop POS + mobile admin) signs in with a
    // ---- silent ANONYMOUS Firebase Auth identity (see src/syncEngine.ts
    // ---- ensureSyncAuth). Requiring `auth != null` here means a random
    // ---- script that only knows the web config can no longer touch your
    // ---- shop data. Requires the "Anonymous" provider to be ENABLED in
    // ---- Firebase Console → Authentication → Sign-in method.
    // ---- List every collection used by src/syncEngine.ts and
    // ---- flutter_admin_app/lib/services/firebase_service.dart.
    "sales":           { ".read": "auth != null", ".write": "auth != null" },
    "products":        { ".read": "auth != null", ".write": "auth != null" },
    "customers":       { ".read": "auth != null", ".write": "auth != null" },
    "customer_khata":  { ".read": "auth != null", ".write": "auth != null" },
    "deleted_khata_entries": { ".read": "auth != null", ".write": "auth != null" },
    "expenses":        { ".read": "auth != null", ".write": "auth != null" },
    "vendors":         { ".read": "auth != null", ".write": "auth != null" },
    "purchase_orders": { ".read": "auth != null", ".write": "auth != null" },
    "daily_closings":  { ".read": "auth != null", ".write": "auth != null" },
    "cashier_sessions": { ".read": "auth != null", ".write": "auth != null" },
    "items_to_bring":  { ".read": "auth != null", ".write": "auth != null" },
    "users":           { ".read": "auth != null", ".write": "auth != null" },

    // Ephemeral command queue: mobile POS asks the desktop printer to print.
    // Lives at the ROOT regardless of tenant (see startSyncWorker()).
    "print_requests":  { ".read": "auth != null", ".write": "auth != null" },

    "bindings": {
      "$keyId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)"
      }
    },

    "licenses": {
      // Authenticated apps (e.g. the mobile owner app's license manager,
      // which reads the whole node) need read access at this level. The
      // per-fingerprint public read below stays: src/licensing.ts reads
      // licenses/<fingerprint> through an UNAUTHENTICATED Firebase app
      // instance at startup, so removing it would break license checks and
      // tenant routing on every launch. That exposure is accepted and
      // documented, not an oversight: fingerprints are SHA-256 machine
      // hashes, not enumerable, and no business data lives here.
      ".read": "auth != null",
      "$fingerprint": {
        // Kept readable for the legacy device-code / reseller flow and so the
        // owner app can self-provision its master record.
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)"
      }
    },

    "tenant_map": {
      // Same load-bearing public read as licenses above: the unauthenticated
      // licensing app resolves tenant routing from tenant_map/<fingerprint>
      // before any sign-in exists. Do not tighten without moving those reads
      // behind auth first.
      "$fingerprint": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "tenantOwners": {
      "$tenantId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },

    "tenants": {
      "$tenantId": {
        // Each user's shop data: only the owning Google account may
        // read/write it. This is what makes "each Gmail its own database".
        ".read": "auth != null && root.child('tenantOwners').child($tenantId).val() === auth.uid",
        ".write": "auth != null && root.child('tenantOwners').child($tenantId).val() === auth.uid"
      }
    },

    "config": {
      ".read": true,
      ".write": false
    }
  }
}
