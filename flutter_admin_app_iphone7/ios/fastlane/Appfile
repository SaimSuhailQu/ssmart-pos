# Appfile - Fastlane Configuration for SSmart POS Admin iOS App

# Your Apple ID email address
# This should be set via environment variable: FASTLANE_USER or passed as parameter
# Example: fastlane beta --env FASTLANE_USER=your@email.com
apple_id ENV["FASTLANE_USER"] || ENV["APPLE_ID"] || "your-apple-id@example.com"

# Your Developer Portal Team ID
# Find this at: https://developer.apple.com/account/#/membership
# Set via environment variable: FASTLANE_TEAM_ID
team_id ENV["FASTLANE_TEAM_ID"] || "YOUR_TEAM_ID"

# App Store Connect Team ID (if different from Developer Portal Team ID)
# Usually the same as team_id, only needed if you're part of multiple teams
itc_team_id ENV["FASTLANE_ITC_TEAM_ID"] || ENV["FASTLANE_TEAM_ID"] || "YOUR_TEAM_ID"

# The bundle identifier for your app
app_identifier "com.ssmartpos"

# For more information about the Appfile, see:
#     https://docs.fastlane.tools/advanced/#appfile
