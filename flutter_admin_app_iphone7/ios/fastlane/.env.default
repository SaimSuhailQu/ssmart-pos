# Default Environment Variables for Fastlane
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real credentials!

# Apple Developer Account
# FASTLANE_USER=your-apple-id@example.com
# FASTLANE_TEAM_ID=YOUR_TEAM_ID
# FASTLANE_ITC_TEAM_ID=YOUR_TEAM_ID

# Fastlane Match - Code Signing
# MATCH_GIT_URL=https://github.com/YOUR_USERNAME/certificates.git
# MATCH_GIT_BASIC_AUTH=base64_encoded_username_token
# MATCH_PASSWORD=your_match_encryption_password
# MATCH_KEYCHAIN_NAME=fastlane_keychain
# MATCH_KEYCHAIN_PASSWORD=your_keychain_password

# App-Specific
# APP_IDENTIFIER=com.ssmartpos.admin

# Optional - Changelog for TestFlight
# CHANGELOG=Bug fixes and improvements

# Skip git status check (for testing)
# SKIP_GIT_CHECK=true
